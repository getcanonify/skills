{
  "name": "Analysis.board",
  "managed_by": "managed",
  "source_ref": null,
  "definition": {
    "title": "Board",
    "icon": "kanban",
    "object_type": "analysis",
    "spec": {
      "type": "board",
      "source": {
        "objectType": "analysis",
        "filter": { "status": { "in": ["queued", "running", "complete", "released"] } },
        "sort": "due_at"
      },
      "groupBy": "status",
      "overdue": "is_overdue",
      "lanes": { "released": { "sort": "-released_at", "limit": 5 } },
      "columns": [
        { "ref": "title", "label": "Analysis" },
        "client_id",
        { "ref": "due_at", "label": "Due" },
        "priority"
      ],
      "rowActions": [
        "analysis.start",
        "analysis.complete",
        { "action": "analysis.release", "label": "Release" },
        { "action": "analysis.cancel", "label": "Cancel" }
      ],
      "createAction": "analysis.request"
    }
  }
}
